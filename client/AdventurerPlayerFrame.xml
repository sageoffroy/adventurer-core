<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!--
        Adventurer-only auxiliary resource controls.
        Measurements mirror the reference PlayerFrame layout supplied from the
        classless client, but only use widgets available in stock WotLK 3.3.5a.
        Native PlayerFrame health/mana/art are repositioned by AdventurerResources.lua.
    -->
    <Frame name="AdventurerPlayerFrameElements" parent="PlayerFrame" setAllPoints="true">
        <Layers>
            <Layer level="BACKGROUND">
                <FontString name="PlayerFrameEnergyBarText" inherits="TextStatusBarText" hidden="true">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="PlayerFrame" relativePoint="CENTER">
                            <Offset>
                                <AbsDimension x="50" y="-22"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="PlayerFrameRageBarText" inherits="TextStatusBarText" hidden="true">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="PlayerFrame" relativePoint="TOPRIGHT">
                            <Offset>
                                <AbsDimension x="-2" y="-42"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <StatusBar name="PlayerFrameEnergyBar" parent="PlayerFrame" inherits="TextStatusBar" hidden="true">
        <Size>
            <AbsDimension x="92" y="11"/>
        </Size>
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="PlayerFrame" relativePoint="TOPLEFT">
                <Offset>
                    <AbsDimension x="117" y="-65"/>
                </Offset>
            </Anchor>
        </Anchors>
        <Scripts>
            <OnLoad>
                TextStatusBar_Initialize(self);
                self.textLockable = 1;
                self.cvar = "playerStatusText";
                self.cvarLabel = "STATUS_TEXT_PLAYER";
            </OnLoad>
            <OnMouseUp>
                self:GetParent():Click(button);
            </OnMouseUp>
        </Scripts>
        <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
        <BarColor r="1" g="1" b="0"/>
    </StatusBar>

    <StatusBar name="PlayerFrameRageBar" parent="PlayerFrame" inherits="TextStatusBar" orientation="VERTICAL" hidden="true">
        <Size>
            <AbsDimension x="12" y="38"/>
        </Size>
        <Anchors>
            <Anchor point="TOPRIGHT" relativeTo="PlayerFrame" relativePoint="TOPRIGHT">
                <Offset>
                    <AbsDimension x="3" y="-24"/>
                </Offset>
            </Anchor>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="0" g="0" b="0" a="0.5"/>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                TextStatusBar_Initialize(self);
                self.textLockable = 1;
                self.cvar = "playerStatusText";
                self.cvarLabel = "STATUS_TEXT_PLAYER";
            </OnLoad>
            <OnMouseUp>
                self:GetParent():Click(button);
            </OnMouseUp>
        </Scripts>
        <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
        <BarColor r="1" g="0" b="0"/>
    </StatusBar>

    <Button name="AdventurerGauntletPledgeBuff" parent="UIParent" hidden="true" frameStrata="HIGH">
        <Size>
            <AbsDimension x="32" y="32"/>
        </Size>
        <Anchors>
            <Anchor point="TOPRIGHT" relativeTo="BuffFrame" relativePoint="TOPLEFT">
                <Offset>
                    <AbsDimension x="-5" y="0"/>
                </Offset>
            </Anchor>
        </Anchors>
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentIcon" file="Interface\Icons\Spell_Shadow_DeathPact">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="2" y="-2"/></Offset></Anchor>
                        <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture file="Interface\Buttons\UI-Quickslot2">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="-1" y="1"/></Offset></Anchor>
                        <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="1" y="-1"/></Offset></Anchor>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                self:RegisterEvent("CHAT_MSG_SYSTEM");
                self:RegisterEvent("PLAYER_ENTERING_WORLD");
            </OnLoad>
            <OnEvent>
                if event == "PLAYER_ENTERING_WORLD" then
                    self:Hide();
                    return;
                end

                local message = ...;
                if not message then return; end

                if string.find(message, "Juramento del Ultimo Aliento", 1, true) or string.find(message, "El pacto de Khadgar ha quedado sellado", 1, true) then
                    self:Show();
                elseif string.find(message, "Has caido", 1, true) or string.find(message, "Su muerte es definitiva", 1, true) then
                    self:Hide();
                end
            </OnEvent>
            <OnEnter>
                GameTooltip:SetOwner(self, "ANCHOR_BOTTOMLEFT");
                GameTooltip:AddLine("Juramento del Último Aliento", 0.69, 0.28, 0.97);
                GameTooltip:AddLine("El pacto de Khadgar sigue vigente.", 1, 1, 1, true);
                GameTooltip:AddLine("Si mueres, este personaje no podrá volver a la vida.", 1, 0.2, 0.2, true);
                GameTooltip:Show();
            </OnEnter>
            <OnLeave>
                GameTooltip:Hide();
            </OnLeave>
        </Scripts>
    </Button>
</Ui>
